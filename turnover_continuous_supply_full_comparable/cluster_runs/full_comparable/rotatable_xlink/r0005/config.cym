% Continuous supply full-comparable case: full_comparable / rotatable_xlink / r0005
% Matches the older c80/m12 annulus scale: inner/outer 10.5/11, z -20 to 20.
% Aggressive depolymerization variant: 2x diffuse bottom chewers and 2x per-chewer chewing speed.
% Initial aligned network plus pulsed top actin supply and bottom minus-end chewing.
% Endpoints are minus first, plus second; plus end is green/growing.
set simul system
{
    steric = 1, 500
    time_step = 0.004
    kT = 0.0042
    viscosity = 0.1
}

set system display
{
    back_color = white
}

set space stripbox
{
    shape = annulus
    display = ( color = blue; )
}

new stripbox
{
    outer = 11.0
    inner = 10.5
    top = 20.0
    bottom = -20.0
}

set space chewer_zone
{
    shape = annulus
    display = ( visible = 0; color = red; )
}

new chewer_zone
{
    outer = 11.0
    inner = 10.5
    top = -8.0
    bottom = -20.0
}

set hand actin_binder
{
    binding_rate = 10
    binding_range = 0.150
    unbinding_rate = 0.08
    unbinding_force = 5
    display = ( color = cyan; )
}

set couple crosslinker
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 10
    diffusion = 10
    specificity = parallel
}

set fiber actin
{
    rigidity = 0.075
    segmentation = 0.18
    steric = 1, 0.025
    confine = inside, 200

    activity = grow
    growing_speed = 0.3, 0
    growing_force = inf, inf
    total_polymer = 19008.0
    min_length = 0.18
    max_chewing_speed = 3.0

    display = ( color = black; )
}

set hand chewer1
{
    binding_rate = 50.0
    binding_range = 0.15
    unbinding_rate = 0.2
    activity = chew
    bind_also_end = minus_end
    bind_only_end = minus_end, 0.5
    hold_growing_end = 0, 1
    chewing_speed = 1.6
    diffusion = 0.2
    display = ( color = red; size = 4; )
}

set single cutter1
{
    hand = chewer1
    stiffness = 1
    activity = diffuse
    diffusion = 10.0
    confine = inside, 0, chewer_zone
}

set hand motor1
{
    binding_rate = 10
    binding_range = 0.02
    unbinding_rate = 0.3
    activity = move
    unloaded_speed = 2.0
    stall_force = 4
    unbinding_force = 2.5
    display = ( color = blue; size = 4; )
}

set single myosin1
{
    hand = motor1
    stiffness = 100
    diffusion = 10
    activity = fixed
}

% Initial full-height aligned filaments.
