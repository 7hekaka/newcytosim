% Generated by ast/tethered_mt_free_actin_long_replicates/generate_tethered_mt_free_actin_long_replicates.py
% Planner target: replicated tethered microtubules plus free actin, no direct actin-MT binding.
% System: small_system (small 12x12x1.2 um)
% Case: 05_growing_mt_perinuclear_actin_long
% Replicate: r0002
% Description: Growing tethered MT asters from short seeds, free perinuclear actin, doubled actin pool.
% Actin total_polymer = 1200 um; actin max_length = 16 um.
% Fixed MT length = 6.0 um.

set simul system
{
    random_seed = 62502
    steric    = 1, 500
    time_step = 0.005
    kT        = 0.0042
    viscosity = 0.1
}
set system display { back_color=white }

set space box { shape = rectangle }
new box { length = 12, 12, 1.2 }

set fiber ACTIN
{
    binding_key   = 1
    rigidity      = 0.075
    segmentation  = 0.12
    steric        = 1, 0.025
    confine       = inside, 200

    activity        = treadmill
    growing_speed   = 0.20, 0.00
    shrinking_speed = 0.00, -0.05
    growing_force   = inf, inf

    total_polymer = 1200
    max_length    = 16
    display = ( color=black; line=3; )
}

set hand actin_binder
{
    binding_key     = 1
    binding_rate    = 5
    binding_range   = 0.150
    unbinding_rate  = 0.2
    unbinding_force = 5
    display = ( color=cyan; )
}

set couple xlk_par
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = parallel
}

set couple xlk_anti
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = antiparallel
}

        set fiber MT
        {
            binding_key   = 3
            rigidity      = 20
            segmentation  = 0.25
            steric        = 1, 0.025
            confine       = inside, 200

activity          = classic
growing_speed     = 0.35
shrinking_speed   = -0.60
catastrophe_rate  = 0.04, 0.20
rescue_rate       = 0.05
growing_force     = 1.67
persistent        = 1
min_length        = 0.3
total_polymer     = inf

            display = ( color=green; plus_end=white, 3; line=4; )
        }

        set solid nucCore
        {
            steric = 1, 0.025
            display = ( color=blue; style=3; )
        }

        set aster mtTether
        {
            stiffness = 1000, 500
            nucleate  = 1, MT, ( plus_end=grow; length=0.8; )
        }

new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=8, MT, ( plus_end=grow; length=1.0; ); position = -3.000 -2.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=8, MT, ( plus_end=grow; length=1.0; ); position =  3.000 -2.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=8, MT, ( plus_end=grow; length=1.0; ); position = -3.000  2.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=8, MT, ( plus_end=grow; length=1.0; ); position =  3.000  2.000  0.000; }

new 12 ACTIN { position = disc 1.3 0.35 at -3.000 -2.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 12 ACTIN { position = disc 1.3 0.35 at  3.000 -2.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 12 ACTIN { position = disc 1.3 0.35 at -3.000  2.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 12 ACTIN { position = disc 1.3 0.35 at  3.000  2.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 48 xlk_par  { position = inside; }
new 48 xlk_anti { position = inside; }

new event
{
    delay = 10
    stop = 300
    code = (
        new 1 ACTIN { position = disc 1.3 0.35 at -3.000 -2.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 1 ACTIN { position = disc 1.3 0.35 at  3.000 -2.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 1 ACTIN { position = disc 1.3 0.35 at -3.000  2.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 1 ACTIN { position = disc 1.3 0.35 at  3.000  2.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
    )
}

run 60000 system { nb_frames = 150 }
