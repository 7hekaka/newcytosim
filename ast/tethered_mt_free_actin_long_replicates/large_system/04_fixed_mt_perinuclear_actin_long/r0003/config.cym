% Generated by ast/tethered_mt_free_actin_long_replicates/generate_tethered_mt_free_actin_long_replicates.py
% Planner target: replicated tethered microtubules plus free actin, no direct actin-MT binding.
% System: large_system (large 24x24x1.2 um)
% Case: 04_fixed_mt_perinuclear_actin_long
% Replicate: r0003
% Description: Fixed-length tethered MT asters, free perinuclear actin, doubled actin pool.
% Actin total_polymer = 4800 um; actin max_length = 16 um.
% Fixed MT length = 12.0 um.

set simul system
{
    random_seed = 72403
    steric    = 1, 500
    time_step = 0.005
    kT        = 0.0042
    viscosity = 0.1
}
set system display { back_color=white }

set space box { shape = rectangle }
new box { length = 24, 24, 1.2 }

set fiber ACTIN
{
    binding_key   = 1
    rigidity      = 0.075
    segmentation  = 0.12
    steric        = 1, 0.025
    confine       = inside, 200

    activity        = treadmill
    growing_speed   = 0.20, 0.00
    shrinking_speed = 0.00, -0.05
    growing_force   = inf, inf

    total_polymer = 4800
    max_length    = 16
    display = ( color=black; line=3; )
}

set hand actin_binder
{
    binding_key     = 1
    binding_rate    = 5
    binding_range   = 0.150
    unbinding_rate  = 0.2
    unbinding_force = 5
    display = ( color=cyan; )
}

set couple xlk_par
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = parallel
}

set couple xlk_anti
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = antiparallel
}

set fiber MT
{
    binding_key   = 3
    rigidity      = 20
    segmentation  = 0.25
    steric        = 1, 0.025
    confine       = inside, 200

    display = ( color=green; plus_end=white, 3; line=4; )
}

set solid nucCore
{
    steric = 1, 0.025
    display = ( color=blue; style=3; )
}

set aster mtTether
{
    stiffness = 1000, 500
    nucleate  = 1, MT, ( length=12; )
}

new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=16, MT, ( length=12; ); position = -6.000 -6.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=16, MT, ( length=12; ); position =  6.000 -6.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=16, MT, ( length=12; ); position = -6.000  6.000  0.000; }
new 1 mtTether { solid=nucCore; radius=0.5; point1=center, 0.5; fibers=16, MT, ( length=12; ); position =  6.000  6.000  0.000; }

new 48 ACTIN { position = disc 1.3 0.35 at -6.000 -6.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 48 ACTIN { position = disc 1.3 0.35 at  6.000 -6.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 48 ACTIN { position = disc 1.3 0.35 at -6.000  6.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 48 ACTIN { position = disc 1.3 0.35 at  6.000  6.000  0.000; length = 1.5; plus_end = grow; minus_end = shrink; }
new 192 xlk_par  { position = inside; }
new 192 xlk_anti { position = inside; }

new event
{
    delay = 10
    stop = 300
    code = (
        new 4 ACTIN { position = disc 1.3 0.35 at -6.000 -6.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 4 ACTIN { position = disc 1.3 0.35 at  6.000 -6.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 4 ACTIN { position = disc 1.3 0.35 at -6.000  6.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
        new 4 ACTIN { position = disc 1.3 0.35 at  6.000  6.000  0.000; length = 0.5; plus_end = grow; minus_end = shrink; }
    )
}

run 60000 system { nb_frames = 150 }
