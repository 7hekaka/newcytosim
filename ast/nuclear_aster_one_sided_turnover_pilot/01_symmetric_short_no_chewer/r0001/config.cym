% Generated by ast/nuclear_aster_one_sided_turnover_pilot/generate_one_sided_turnover_pilot.py
% Purpose: short-filament test for one-sided nucleus-proximal actin turnover.
% Case: 01_symmetric_short_no_chewer
% Replicate: r0001
% Description: Symmetric short nucleus-bound aster without localized turnover factors.
% Filament cap: max_length=2.5 um; initial_length=2.0 um

set simul system
{
    random_seed = 76101
    steric    = 1, 500
    time_step = 0.005
    kT        = 0.0042
    viscosity = 0.1
}
set system display { back_color=white }

set space box { shape = rectangle }
new box { length = 16, 8, 1.2 }

set fiber ACTIN
{
    binding_key   = 1
    rigidity      = 0.075
    segmentation  = 0.12
    steric        = 1, 0.025
    confine       = inside, 200

    activity        = treadmill
    growing_speed   = 0.750, 0.00
    shrinking_speed = 0.00, -0.350
    growing_force   = inf, inf

    total_polymer = 160
    max_length    = 2.5
    display = ( color=black; line=3; )
}

set hand actin_binder
{
    binding_key     = 1
    binding_rate    = 5
    binding_range   = 0.150
    unbinding_rate  = 0.2
    unbinding_force = 5
    display = ( color=cyan; )
}

set couple xlk_par
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = parallel
}

set couple xlk_anti
{
    hand1 = actin_binder
    hand2 = actin_binder
    stiffness = 1
    diffusion = 10
    activity = crosslink
    specificity = antiparallel
}

set hand actin_chewer
{
    binding_key = 1
    binding = 12, 0.180
    unbinding = 0.4, 3
    activity = chew
    bind_also_end = both_ends
    hold_growing_end = 1
    hold_shrinking_end = 1
    chewing_speed = 0.120
    display = ( color=magenta; )
}

set single actin_chewer_fixed
{
    hand = actin_chewer
    activity = fixed
    stiffness = 0
    diffusion = 0
    save_unbound = 1
}

set solid nucCore
{
    steric = 1, 0.025
    confine = inside, 200
    display = ( color=blue; style=3; )
}

set aster nucAster
{
    stiffness = 1000, 500
    nucleate  = 1.5, ACTIN, ( plus_end=grow; minus_end=shrink; length=2.0; )
}

new 1 nucAster { solid=nucCore; type=regular; radius=0.5, 0.12; fibers=24, ACTIN, ( plus_end=grow; minus_end=shrink; length=2.0; ); position = -3.000  0.000  0.000; }
new 24 xlk_par  { position = inside; }
new 24 xlk_anti { position = inside; }

run 12000 system { nb_frames = 60 }
