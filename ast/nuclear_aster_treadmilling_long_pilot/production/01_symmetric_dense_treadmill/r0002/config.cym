% Replicate: r0002
% Description: Symmetric dense nucleus-bound actin aster with treadmilling-only turnover.
% Key setup: no chewers; actin starts at 0.1 um; max_length=1.0 um; total_polymer=12000 um

set simul system
{
    random_seed = 78102
    steric    = 1, 500
    time_step = 0.005
    kT        = 0.0042
    viscosity = 0.1
}
set system display { back_color=white }

set space box { shape = rectangle }
new box { length = 32.0, 16.0, 2.0 }

set fiber ACTIN
{
    binding_key   = 1
    rigidity      = 0.075
    segmentation  = 0.10
    steric        = 1, 0.025
    confine       = inside, 200

    activity        = treadmill
    growing_speed   = 0.750, 0.00
    shrinking_speed = 0.00, -0.350
    growing_force   = inf, inf

    total_polymer = 12000
    max_length    = 1.0
    display = ( color=black; line=3; )
}

set solid nucCore
{
    viscosity = 20
    steric = 1, 0.025
    confine = inside, 200
    display = ( color=blue; style=3; )
}

set aster nucAster
{
    stiffness = 1000, 500
    nucleate  = 3.0, ACTIN, ( plus_end=grow; minus_end=shrink; length=0.1; )
}

new 1 nucAster { solid=nucCore; type=regular; radius=0.5, 0.10; fibers=120, ACTIN, ( plus_end=grow; minus_end=shrink; length=0.1; ); position =  0.000  0.000  0.000; }

run 60000 system { nb_frames = 300 }
