% Generated by ast/nuclear_propulsion_mechanism_mockups/generate_mechanism_mockups.py
% Purpose: minimal mechanism screen for directed nuclear motion.
% Case: 08_push_filaments_unanchored
% Replicate: r0001
% Description: Lab-frame filaments seeded on the minus-x side and growing toward the nucleus; no anchors.
% Duration: 4.000 s; frames=8

set simul system
{
    random_seed = 91801
    steric    = 1, 500
    time_step = 0.005
    kT        = 0.0042
    viscosity = 0.1
}
set system display { back_color=white }

set space box { shape = rectangle }
new box { length = 18.0, 9.0, 1.4 }


set fiber ACTIN
{
    binding_key   = 1
    rigidity      = 0.075
    segmentation  = 0.10
    steric        = 1, 0.025
    confine       = inside, 200

    activity        = treadmill
    growing_speed   = 0.65, 0.00
    shrinking_speed = 0.00, -0.25
    growing_force   = inf, inf

    total_polymer = 12000
    max_length    = 3.0
    display = ( color=black; line=3; )
}

set hand cortex_binder_hand
{
    binding_key     = 1
    binding         = 12, 0.180
    unbinding       = 0.050, 5
    display = ( color=cyan; )
}

set hand cortex_motor_plus
{
    binding_key     = 1
    binding         = 12, 0.180
    unbinding       = 0.120, 5
    activity        = move
    unloaded_speed  = 0.35
    stall_force     = 5
    display = ( color=red; )
}

set hand cortex_motor_minus
{
    binding_key     = 1
    binding         = 12, 0.180
    unbinding       = 0.120, 5
    activity        = move
    unloaded_speed  = -0.35
    stall_force     = 5
    display = ( color=orange; )
}

set single fixed_binder
{
    hand = cortex_binder_hand
    activity = fixed
    stiffness = 25
    diffusion = 0
    save_unbound = 1
}

set single fixed_motor_plus
{
    hand = cortex_motor_plus
    activity = fixed
    stiffness = 25
    diffusion = 0
    save_unbound = 1
}

set single fixed_motor_minus
{
    hand = cortex_motor_minus
    activity = fixed
    stiffness = 25
    diffusion = 0
    save_unbound = 1
}

set solid nucCore
{
    viscosity = 80
    steric = 1, 0.050
    confine = inside, 200
    display = ( color=blue; style=3; )
}

set bead nucBody
{
    viscosity = 80
    steric = 1, 0.050
    confine = inside, 200
    display = ( color=blue; style=7; )
}

set aster nucAster
{
    stiffness = 1000, 500
    nucleate  = 1.0, ACTIN, ( plus_end=grow; minus_end=shrink; length=1.1; )
}


new 1 nucBody { radius = 0.5; position =  0.000  0.000  0.000; }
new 48 ACTIN { position = rectangle 0.70 1.80 0.70 at -1.180 0 0; direction = 1 0 0; length = 0.35; plus_end = grow; minus_end = shrink; placement = anywhere; }

run 800 system { nb_frames = 8 }
